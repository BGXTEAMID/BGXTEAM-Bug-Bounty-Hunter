FROM node:22-alpine AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend ./
RUN npm run build

FROM gcc:13-bookworm AS native
WORKDIR /src
COPY engine/native/main.cpp engine/native/main.cpp
RUN mkdir -p engine/native/build && g++ -std=c++17 -O2 -Wall -Wextra -Wpedantic -Wconversion -Wshadow engine/native/main.cpp -o engine/native/build/bgx-native-worker

FROM python:3.12-slim AS runtime
WORKDIR /app
COPY requirements-platform.txt ./
RUN pip install --no-cache-dir -r requirements-platform.txt
COPY services ./services
COPY policies ./policies
COPY engine/native/CMakeLists.txt engine/native/main.cpp ./engine/native/
COPY --from=native /src/engine/native/build/bgx-native-worker ./engine/native/build/bgx-native-worker
COPY --from=frontend /src/frontend/dist ./frontend/dist
RUN useradd --create-home --uid 10001 appuser && mkdir -p data logs && chown -R appuser:appuser /app
USER appuser
ENV DEV_PREVIEW=false PORT=8000 BGX_NATIVE_WORKER=/app/engine/native/build/bgx-native-worker PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["sh", "-c", "python -m uvicorn services.api.main:app --host 0.0.0.0 --port ${PORT}"]
